# Codex Waypoint inference (real GPU server on your Windows PC)
VITE_WORLD_API_BASE_URL=http://127.0.0.1:8000

# Optional: force Vite proxy target (dev only). Defaults to VITE_WORLD_API_BASE_URL.
# ENGINE_TARGET=http://127.0.0.1:8000

# Optional live Rescue Lab / PPO API (not required for static package)
# VITE_LIVE_SIM_URL=http://127.0.0.1:4822

# Optional scene-generation HTTP API (text→seed image). Untyped mock used if unset.
# VITE_SCENE_API_BASE_URL=http://127.0.0.1:8000
