# Product native-720p memory backend (claude/live-memory-backend) — use :8002
VITE_WORLD_API_BASE_URL=http://127.0.0.1:8002

# Vite /engine proxy target (dev). Must match the live backend on Windows.
ENGINE_TARGET=http://127.0.0.1:8002

# World memory client: live | mock (default mock).
# live ⇒ capability gate (Waypoint-1.5-1B + memory_api + world-memory-v1.1 + 1280×720).
# Never silently falls back to MOCK when live is requested — UI shows "Memory unavailable".
VITE_WORLD_MEMORY_SOURCE=mock

# Archived 360p regression service only — do not target for new Explorer features:
# VITE_WORLD_API_BASE_URL=http://127.0.0.1:8000

# SDXL / scene seed API (Create Anything).
# VITE_SCENE_API_BASE_URL=http://127.0.0.1:8002

# Optional live Rescue Lab / PPO API (not required — missions use browser sim + static JSON)
# VITE_LIVE_SIM_URL=http://127.0.0.1:4822
