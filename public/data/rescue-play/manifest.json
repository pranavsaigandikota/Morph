{
  "package": "@worldshift/rescue-play",
  "format_version": 1,
  "disclaimer": "Fictional scenario. A discrete grid abstraction for gameplay and evaluation only; it is not representative of real-world flood, storm, structural or chemical behaviour and must not be used for operational planning or emergency response.",
  "coordinate_system": {
    "format": "[x, y]",
    "origin": "top-left",
    "x_axis": "right",
    "y_axis": "down",
    "grid_indexing": "grid[y][x]",
    "actions": {
      "0": "up (y-1)",
      "1": "down (y+1)",
      "2": "left (x-1)",
      "3": "right (x+1)"
    }
  },
  "action_mapping": {
    "0": {
      "name": "up",
      "delta_xy": [
        0,
        -1
      ]
    },
    "1": {
      "name": "down",
      "delta_xy": [
        0,
        1
      ]
    },
    "2": {
      "name": "left",
      "delta_xy": [
        -1,
        0
      ]
    },
    "3": {
      "name": "right",
      "delta_xy": [
        1,
        0
      ]
    }
  },
  "rules": "Identical to rescue_sim RescueEnv (see README rules table); default rewards, hazard_terminates=true.",
