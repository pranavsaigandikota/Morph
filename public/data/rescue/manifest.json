{
  "version": 1,
  "title": "Rescue Lab — Static Evaluation Package",
  "description": "Recorded maps, agent trajectories, evaluation metrics, and training history. No live simulator or PPO service required.",
  "mode": "recorded_evaluation",
  "handoff_note": "Copy this directory into public/data/rescue/ after exporting from the training pipeline. The frontend loads everything via fetch(manifest.json).",
  "default_map_id": "facility_a",
  "default_agent_id": "ppo-rescue-v1",
  "default_trajectory_id": "traj_ppo_south",
  "maps": [
    {
      "id": "facility_a",
      "path": "maps/facility_a.json",
      "title": "Research Facility A — Sublevel 2"
    }
  ],
  "agents": [
    {
      "id": "baseline-heuristic",
      "path": "agents/baseline-heuristic.json",
      "name": "Baseline Heuristic"
    },
    {
      "id": "ppo-rescue-v1",
      "path": "agents/ppo-rescue-v1.json",
      "name": "PPO Rescue v1"
    },
    {
      "id": "ppo-path-guidance",
      "path": "agents/ppo-path-guidance.json",
      "name": "PPO + Path Guidance"
    },
    {
      "id": "random-walker",
      "path": "agents/random-walker.json",
      "name": "Random Walker"
    },
    {
      "id": "astar-planner",
      "path": "agents/astar-planner.json",
      "name": "A* Planner"
    }
  ],
  "trajectories": [
    {
      "id": "traj_baseline_south",
      "path": "trajectories/traj_baseline_south.json",
      "agent_id": "baseline-heuristic",
      "map_id": "facility_a",
      "label": "Baseline · south exit"
    },
    {
      "id": "traj_ppo_north",
      "path": "trajectories/traj_ppo_north.json",
      "agent_id": "ppo-rescue-v1",
      "map_id": "facility_a",
      "label": "PPO v1 · north exit"
    },
    {
      "id": "traj_ppo_south",
      "path": "trajectories/traj_ppo_south.json",
      "agent_id": "ppo-rescue-v1",
      "map_id": "facility_a",
      "label": "PPO v1 · south exit (best)"
    },
    {
      "id": "traj_random_south",
      "path": "trajectories/traj_random_south.json",
      "agent_id": "random-walker",
      "map_id": "facility_a",
      "label": "Random · south exit (noisy)"
    },
    {
      "id": "traj_astar_south",
      "path": "trajectories/traj_astar_south.json",
      "agent_id": "astar-planner",
      "map_id": "facility_a",
      "label": "A* · south exit (shortest)"
    }
  ],
  "evaluations": [
    {
      "id": "eval_verified_showdown",
      "path": "evaluations/eval_verified_showdown.json",
      "title": "AI Showdown — verified rates"
    },
    {
      "id": "eval_facility_night",
      "path": "evaluations/eval_facility_night.json",
      "title": "Facility night evaluation (legacy package)"
    }
  ],
  "training_history": [
    {
      "id": "train_ppo_v1",
      "path": "training/train_ppo_v1.json",
      "agent_id": "ppo-rescue-v1",
      "title": "PPO v1 training curve"
    }
  ],
  "comparisons": [
    {
      "id": "cmp_facility_methods",
      "title": "Random vs A* vs PPO + Path Guidance (recorded)",
      "trajectory_ids": [
        "traj_random_south",
        "traj_astar_south",
        "traj_ppo_south"
      ]
    }
  ]
}